# Base de l'API backend
VITE_API_URL=http://localhost:8000

# Identifiant NUMÉRIQUE du bot Telegram = les chiffres AVANT le ":" du token
# BotFather (ex. token 8123456789:AAH... -> VITE_TELEGRAM_BOT_ID=8123456789).
# Non secret. Requis pour la popup de connexion.
VITE_TELEGRAM_BOT_ID=8123456789

# Nom du bot (sans @) — informatif. Le domaine du site doit être déclaré
# sur le bot via /setdomain dans BotFather.
VITE_TELEGRAM_BOT=MonBotRiskly
