# --- Base de données ---
# SQLite en dev ; en prod, une URL Postgres (postgresql+psycopg://...)
DATABASE_URL=sqlite:///./riskly.db

# --- Sécurité ---
# Clé de signature des cookies de session (générer une chaîne aléatoire longue)
SECRET_KEY=changez-moi-par-une-chaine-aleatoire-longue

# --- Telegram Login Widget ---
# Token du bot obtenu via @BotFather (garder secret !).
# Déclarer le domaine du site sur le bot via /setdomain.
TELEGRAM_BOT_TOKEN=

# --- CORS (origines front autorisées, séparées par des virgules) ---
CORS_ORIGINS=http://localhost:5173

# --- Cookie de session ---
# COOKIE_SECURE=true en production (HTTPS obligatoire).
# COOKIE_SAMESITE=none si front et back sont sur des domaines différents
# (exige alors COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
