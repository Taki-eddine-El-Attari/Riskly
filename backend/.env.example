# --- Base de données (Postgres) ---
# Format : postgresql+psycopg://UTILISATEUR:MOTDEPASSE@HOTE:5432/NOMBASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/riskly

# --- Sécurité ---
# Clé de signature du cookie de session (générer une chaîne aléatoire longue)
SECRET_KEY=changez-moi-par-une-chaine-aleatoire-longue

# --- Auth Telegram (Login Widget) ---
# Token du bot @BotFather (garder secret !). Vide = login Telegram désactivé.
# Déclarer le domaine du site sur le bot via /setdomain.
TELEGRAM_BOT_TOKEN=

# --- CORS (origines front autorisées, séparées par des virgules) ---
CORS_ORIGINS=http://localhost:5173

# --- Cookie de session ---
# COOKIE_SECURE=true en production (HTTPS obligatoire).
# COOKIE_SAMESITE=none si front et back sont sur des domaines différents
# (exige alors COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Stockage des CSV de warm-up (option ① : volume privé) -------------------
# Répertoire dédié, HORS du dépôt et jamais servi en statique. DOIT être sur un
# volume chiffré au repos. En prod, monter un volume dédié et donner les droits
# au seul utilisateur applicatif (ex. chown app:app, chmod 700).
WARMUP_STORAGE_DIR=/var/lib/riskly/warmup
# Plafond par fichier, en octets (défaut 5 Mio).
WARMUP_MAX_SIZE_BYTES=5242880
# Extensions autorisées (séparées par des virgules, sans le point).
WARMUP_ALLOWED_EXTENSIONS=csv
